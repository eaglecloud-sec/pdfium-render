+TEST_F(PDFCatalogTest, GetCustomStream) {
+  constexpr char kKey[] = "CustomData";
+  constexpr std::array<uint8_t, 4> kData = {'t', 'e', 's', 't'};
+  std::array<uint8_t, 8> buffer = {};
+  unsigned long out_len = 99;
+
+  EXPECT_EQ(FPDF_CATALOG_CUSTOM_STREAM_INVALID_ARGUMENT,
+            FPDFCatalog_GetCustomStream(nullptr, kKey, buffer.size(),
+                                        buffer.data(), buffer.size(),
+                                        &out_len));
+  EXPECT_EQ(0u, out_len);
+  EXPECT_EQ(
+      FPDF_CATALOG_CUSTOM_STREAM_INVALID_ARGUMENT,
+      FPDFCatalog_GetCustomStream(
+          doc_.get(), kKey, FPDF_CATALOG_CUSTOM_STREAM_MAX_SIZE + 1,
+          buffer.data(), FPDF_CATALOG_CUSTOM_STREAM_MAX_SIZE + 1, &out_len));
+  EXPECT_EQ(0u, out_len);
+
+  CPDF_TestDocument* test_doc =
+      static_cast<CPDF_TestDocument*>(CPDFDocumentFromFPDFDocument(doc_.get()));
+  test_doc->SetRoot(root_obj_);
+  EXPECT_EQ(FPDF_CATALOG_CUSTOM_STREAM_MISSING,
+            FPDFCatalog_GetCustomStream(doc_.get(), kKey, buffer.size(),
+                                        buffer.data(), buffer.size(),
+                                        &out_len));
+
+  root_obj_->SetNewFor<CPDF_String>(kKey, "not a stream");
+  EXPECT_EQ(FPDF_CATALOG_CUSTOM_STREAM_NOT_A_STREAM,
+            FPDFCatalog_GetCustomStream(doc_.get(), kKey, buffer.size(),
+                                        buffer.data(), buffer.size(),
+                                        &out_len));
+
+  auto stream = test_doc->NewIndirect<CPDF_Stream>(pdfium::span(kData));
+  root_obj_->SetNewFor<CPDF_Reference>(kKey, test_doc, stream->GetObjNum());
+  EXPECT_EQ(FPDF_CATALOG_CUSTOM_STREAM_SUCCESS,
+            FPDFCatalog_GetCustomStream(doc_.get(), kKey, buffer.size(),
+                                        buffer.data(), buffer.size(),
+                                        &out_len));
+  EXPECT_EQ(kData.size(), out_len);
+  const std::array<uint8_t, 4> actual = {buffer[0], buffer[1], buffer[2],
+                                         buffer[3]};
+  EXPECT_EQ(kData, actual);
+}
