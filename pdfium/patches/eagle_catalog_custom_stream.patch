+FPDF_EXPORT int FPDF_CALLCONV FPDFCatalog_GetCustomStream(
+    FPDF_DOCUMENT document,
+    FPDF_BYTESTRING key,
+    unsigned long max_size,
+    void* buffer,
+    unsigned long buflen,
+    unsigned long* out_len) {
+  if (out_len) {
+    *out_len = 0;
+  }
+  if (!document || !key || !key[0] || !buffer || !out_len || max_size == 0 ||
+      max_size > FPDF_CATALOG_CUSTOM_STREAM_MAX_SIZE || buflen < max_size) {
+    return FPDF_CATALOG_CUSTOM_STREAM_INVALID_ARGUMENT;
+  }
+
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  const CPDF_Dictionary* catalog = doc ? doc->GetRoot() : nullptr;
+  if (!catalog) {
+    return FPDF_CATALOG_CUSTOM_STREAM_DECODE_ERROR;
+  }
+  if (!catalog->KeyExist(key)) {
+    return FPDF_CATALOG_CUSTOM_STREAM_MISSING;
+  }
+
+  RetainPtr<const CPDF_Stream> stream = catalog->GetStreamFor(key);
+  if (!stream) {
+    return FPDF_CATALOG_CUSTOM_STREAM_NOT_A_STREAM;
+  }
+
+  const uint32_t size_limit = static_cast<uint32_t>(max_size);
+  const size_t raw_size = stream->GetRawSize();
+  if (raw_size > size_limit) {
+    return FPDF_CATALOG_CUSTOM_STREAM_TOO_LARGE;
+  }
+
+  auto copy_result = [&](pdfium::span<const uint8_t> data) {
+    if (data.size() > size_limit) {
+      return FPDF_CATALOG_CUSTOM_STREAM_TOO_LARGE;
+    }
+    if (!data.empty()) {
+      std::memcpy(buffer, data.data(), data.size());
+    }
+    *out_len = static_cast<unsigned long>(data.size());
+    return FPDF_CATALOG_CUSTOM_STREAM_SUCCESS;
+  };
+
+  auto raw_access = pdfium::MakeRetain<CPDF_StreamAcc>(stream);
+  raw_access->LoadAllDataRaw();
+  if (raw_access->GetSize() != raw_size) {
+    return FPDF_CATALOG_CUSTOM_STREAM_DECODE_ERROR;
+  }
+
+  RetainPtr<const CPDF_Dictionary> stream_dict = stream->GetDict();
+  if (!stream->HasFilter()) {
+    return copy_result(raw_access->GetSpan());
+  }
+
+  const ByteString filter = stream_dict->GetNameFor("Filter");
+  if (filter != "FlateDecode" && filter != "Fl") {
+    return FPDF_CATALOG_CUSTOM_STREAM_UNSUPPORTED_FILTER;
+  }
+  if (stream_dict->KeyExist("DecodeParms")) {
+    return FPDF_CATALOG_CUSTOM_STREAM_UNSUPPORTED_FILTER;
+  }
+
+  fxcodec::BoundedFlateDecodeResult decoded =
+      FlateModule::FlateDecodeWithSizeLimit(raw_access->GetSpan(), size_limit);
+  if (decoded.output_too_large) {
+    return FPDF_CATALOG_CUSTOM_STREAM_TOO_LARGE;
+  }
+  if (!decoded.success) {
+    return FPDF_CATALOG_CUSTOM_STREAM_DECODE_ERROR;
+  }
+  return copy_result(decoded.data);
+}
