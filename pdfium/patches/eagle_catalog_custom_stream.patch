+// static
+BoundedFlateDecodeResult FlateModule::FlateDecodeWithSizeLimit(
+    pdfium::span<const uint8_t> src_span,
+    uint32_t max_output_size) {
+  BoundedFlateDecodeResult result;
+  if (max_output_size == std::numeric_limits<uint32_t>::max()) {
+    return result;
+  }
+
+  std::unique_ptr<z_stream, FlateDeleter> context(FlateInit());
+  if (!context) {
+    return result;
+  }
+
+  FlateInput(context.get(), src_span);
+  result.data.resize(static_cast<size_t>(max_output_size) + 1u);
+  context->next_out = result.data.data();
+  context->avail_out = pdfium::checked_cast<uint32_t>(result.data.size());
+
+  const int inflate_result = inflate(context.get(), Z_FINISH);
+  const uint32_t decoded_size =
+      pdfium::checked_cast<uint32_t>(context->total_out);
+  if (decoded_size > max_output_size || context->avail_out == 0) {
+    result.data.clear();
+    result.output_too_large = true;
+    return result;
+  }
+  if (inflate_result != Z_STREAM_END) {
+    result.data.clear();
+    return result;
+  }
+
+  result.data.resize(decoded_size);
+  result.success = true;
+  return result;
+}
